<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.caron.basekit.standarddesign.requirement.RequirementMapper">
  <sql id="requirementColumns">REQUIREMENT_ID,PROJECT_ID,REQUIREMENT_NAME,REQUIREMENT_TYPE_CODE,DESCRIPTION,PROCESS_DESCRIPTION,STATUS,LEGACY_WBS_IDS,LEGACY_SCREEN_IDS,LEGACY_TABLE_IDS,LEGACY_SOURCE_ID,REG_DT</sql>
  <sql id="attachmentColumns">ATTACHMENT_ID,REQUIREMENT_ID,ORIGINAL_FILE_NAME,STORAGE_KEY,FILE_TYPE,MIME_TYPE,FILE_SIZE,UPLOAD_DT,ANALYSIS_STATUS</sql>
  <select id="findAll" resultType="com.caron.basekit.standarddesign.requirement.RequirementRow">SELECT <include refid="requirementColumns"/> FROM BSDRREQ WHERE PROJECT_ID = #{PROJECT_ID} ORDER BY REG_DT DESC, REQUIREMENT_ID DESC</select>
  <select id="findOne" resultType="com.caron.basekit.standarddesign.requirement.RequirementRow">SELECT <include refid="requirementColumns"/> FROM BSDRREQ WHERE REQUIREMENT_ID = #{REQUIREMENT_ID}</select>
  <select id="findLegacy" resultType="com.caron.basekit.standarddesign.requirement.RequirementRow">SELECT <include refid="requirementColumns"/> FROM BSDRREQ WHERE PROJECT_ID = #{PROJECT_ID} AND LEGACY_SOURCE_ID = #{LEGACY_SOURCE_ID}</select>
  <insert id="insert">INSERT INTO BSDRREQ (REQUIREMENT_ID,PROJECT_ID,REQUIREMENT_NAME,REQUIREMENT_TYPE_CODE,DESCRIPTION,PROCESS_DESCRIPTION,STATUS,LEGACY_WBS_IDS,LEGACY_SCREEN_IDS,LEGACY_TABLE_IDS,LEGACY_SOURCE_ID) VALUES (#{REQUIREMENT_ID},#{PROJECT_ID},#{REQUIREMENT_NAME},#{REQUIREMENT_TYPE_CODE},#{DESCRIPTION},#{PROCESS_DESCRIPTION},#{STATUS},#{LEGACY_WBS_IDS},#{LEGACY_SCREEN_IDS},#{LEGACY_TABLE_IDS},#{LEGACY_SOURCE_ID})</insert>
  <update id="update">UPDATE BSDRREQ SET REQUIREMENT_NAME=#{REQUIREMENT_NAME},REQUIREMENT_TYPE_CODE=#{REQUIREMENT_TYPE_CODE},DESCRIPTION=#{DESCRIPTION},PROCESS_DESCRIPTION=#{PROCESS_DESCRIPTION},STATUS=#{STATUS},MOD_DT=CURRENT_TIMESTAMP WHERE REQUIREMENT_ID=#{REQUIREMENT_ID}</update>
  <delete id="delete">DELETE FROM BSDRREQ WHERE REQUIREMENT_ID=#{REQUIREMENT_ID}</delete>
  <select id="menuKeys" resultType="string">SELECT MENU_KEY FROM BSDRRMNU WHERE REQUIREMENT_ID=#{REQUIREMENT_ID} ORDER BY MENU_KEY</select>
  <insert id="insertMenu">INSERT INTO BSDRRMNU(REQUIREMENT_ID,MENU_KEY) VALUES(#{REQUIREMENT_ID},#{MENU_KEY})</insert>
  <delete id="deleteMenus">DELETE FROM BSDRRMNU WHERE REQUIREMENT_ID=#{REQUIREMENT_ID}</delete>
  <select id="attachments" resultType="com.caron.basekit.standarddesign.requirement.AttachmentData">SELECT <include refid="attachmentColumns"/> FROM BSDRATCH WHERE REQUIREMENT_ID=#{REQUIREMENT_ID} ORDER BY UPLOAD_DT,ATTACHMENT_ID</select>
  <select id="attachment" resultType="com.caron.basekit.standarddesign.requirement.AttachmentData">SELECT <include refid="attachmentColumns"/> FROM BSDRATCH WHERE ATTACHMENT_ID=#{ATTACHMENT_ID}</select>
  <insert id="insertAttachment">INSERT INTO BSDRATCH(ATTACHMENT_ID,REQUIREMENT_ID,ORIGINAL_FILE_NAME,STORAGE_KEY,FILE_TYPE,MIME_TYPE,FILE_SIZE,ANALYSIS_STATUS) VALUES(#{ATTACHMENT_ID},#{REQUIREMENT_ID},#{ORIGINAL_FILE_NAME},#{STORAGE_KEY},#{FILE_TYPE},#{MIME_TYPE},#{FILE_SIZE},#{ANALYSIS_STATUS})</insert>
  <delete id="deleteAttachment">DELETE FROM BSDRATCH WHERE ATTACHMENT_ID=#{ATTACHMENT_ID}</delete>
  <select id="countActiveRequirementType" resultType="int">SELECT COUNT(*) FROM BSYCMCD WHERE CODE_GROUP_ID='REQUIREMENT_TYPE_CODE' AND CODE=#{CODE} AND USE_YN='Y' AND DEL_YN='N'</select>
</mapper>
